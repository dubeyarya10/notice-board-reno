# .env.example
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Supabase PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"

# Direct URL for Prisma migrations (bypasses PgBouncer)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
